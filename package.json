{
  "name": "image-scanner",
  "version": "2.0.0",
  "description": "A comprehensive web-based image scanner that crawls websites and extracts all images with metadata, featuring advanced filtering, caching, and batch processing capabilities",
  "main": "server.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/davidjakealda95-cmyk/Image_scnr"
  },
  "author": "David Jake Alda",
  "license": "MIT",
  "engines": {
    "node": ">=16.0.0",
    "npm": ">=8.0.0"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "jest --runInBand",
    "test:coverage": "jest --coverage --runInBand",
    "test:watch": "jest --watch",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{js,json,md}\"",
    "format:check": "prettier --check \"**/*.{js,json,md}\"",
    "build": "npm run lint && npm run format:check && npm run test",
    "prod": "NODE_ENV=production node server.js",
    "debug": "node --inspect-brk server.js"
  },
  "keywords": [
    "image-scanner",
    "web-crawler",
    "seo",
    "image-extraction",
    "metadata",
    "batch-processing",
    "caching"
  ],
  "dependencies": {
    "axios": "^1.6.0",
    "cheerio": "^1.0.0-rc.12",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "helmet": "^7.1.0",
    "express-rate-limit": "^7.1.5",
    "express-validator": "^7.0.0",
    "image-size": "^1.0.2",
    "p-limit": "^4.0.0",
    "archiver": "^6.0.1",
    "postcss": "^8.4.32",
    "postcss-value-parser": "^4.2.0",
    "winston": "^3.11.0",
    "redis": "^4.6.12",
    "joi": "^17.11.0",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "nodemon": "^3.0.1",
    "jest": "^29.7.0",
    "supertest": "^6.3.3",
    "eslint": "^8.54.0",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-plugin-import": "^2.29.0",
    "prettier": "^3.1.1"
  }
}
